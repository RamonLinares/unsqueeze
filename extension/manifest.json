{
  "manifest_version": 3,
  "name": "Unsqueeze — Anamorphic Webcam",
  "short_name": "Unsqueeze",
  "version": "1.2.2",
  "description": "Correct anamorphic camera proportions in Google Meet. Adjustable squeeze ratios, crop or letterbox, and local processing.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Unsqueeze", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "content_scripts": [
    { "matches": ["https://meet.google.com/*"], "js": ["core.js", "intercept.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true },
    { "matches": ["https://meet.google.com/*"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": true }
  ]
}
